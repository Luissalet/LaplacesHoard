{
  "schema": 1,
  "id": "laplace",
  "name": "Laplace's Hoard · Nightingale",
  "purpose": "Absorbed by Nightingale's Hoard. Compatibility identity only; no standalone server. Gives the model exact arithmetic, symbolic math, unit conversion, statistics, date arithmetic and read-only SQL over local files, with every computation logged and citable.",
  "capabilities": [
    "arithmetic",
    "symbolic-math",
    "units",
    "statistics",
    "dates",
    "sql-over-files"
  ],
  "placeholders": [
    "LAPLACE_DIR",
    "APP_URL"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:5189/calculation",
    "NIGHTINGALE_DIR": "{LAPLACE_DIR}/../Nightingale's Hoard"
  },
  "app": {
    "url_default": "http://127.0.0.1:5189/calculation",
    "ui_url": "http://127.0.0.1:5189/",
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "absorbed-laplace"
      }
    },
    "identify": {
      "service": [
        "laplaces-hoard"
      ],
      "title": [
        "laplace's hoard"
      ]
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{NIGHTINGALE_DIR}/venv/Scripts/python.exe",
    "args": [
      "{NIGHTINGALE_DIR}/mcp_server.py"
    ],
    "env": {
      "NIGHTINGALE_URL": "http://127.0.0.1:5189",
      "NIGHTINGALE_TOKEN_FILE": "{NIGHTINGALE_DIR}/data/mcp-token"
    },
    "optional_env": [
      "NIGHTINGALE_DATA_DIR"
    ]
  },
  "provides": {
    "skills": [
      "skills/exact-numbers/SKILL.md"
    ]
  },
  "notes": "Local-only calculator, symbolic-math and SQL-over-files tool. The model should call its tools rather than compute numbers itself, and cite the returned id.",
  "x-family": {
    "copilot": {
      "contract_version": "1.0",
      "info": "/api/copilot/info",
      "panel": "/api/copilot/panel.js",
      "proxy": "/api/copilot/proxy",
      "context_provider": "window.hoardCopilot.context",
      "object_types": [
        "cell",
        "computation",
        "dataset"
      ]
    },
    "absorbed_by": {
      "id": "nightingale",
      "repository": "https://github.com/Luissalet/NightingalesHoard",
      "module": "calculation",
      "standalone": false
    }
  }
}
